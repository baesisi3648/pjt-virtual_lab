# Original prompt set of the first submission (source of prompts_A/ and prompts_B/)
# The prompts used in the study are public in prompts_A/ and prompts_B/.
prompts/

# Reproducibility experiment runs (large; regenerated on demand)
experiments/runs/
experiments/reproducibility/results/

# Revision baseline: archive and diffs contain the original (pre-revision) prompt text.
# Kept locally until the decision on publishing the original prompts (revision_plan D3).
experiments/runs_rev/baseline/original_archive.zip
experiments/runs_rev/prompt_sets/*.patch
.prompts_*.building/

# Revision: retrieval snapshot holds third-party web excerpts; publish only after redistribution check (revision_plan section 13)
experiments/runs_rev/retrieval_snapshot.json

# Revision: pilot runs and pilot analyses contain retrieval excerpts (third-party text); publish only after the redistribution check (revision_plan section 13)
